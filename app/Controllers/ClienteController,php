<?php
require_once __DIR__ . '/../Models/Database.php';

class ClienteController {
    // Exibe o formulário de cadastro
    public function index() {
        require __DIR__ . '/../Views/cadastro_cliente.php';
    }

    // Processa o formulário e salva no banco
    public function salvar() {
        if ($_SERVER['REQUEST_METHOD'] === 'POST') {
            $pdo = Database::getInstance();
            $stmt = $pdo->prepare(
                "INSERT INTO clientes (tipo_pessoa, cpf_cnpj, nome_razao, email, telefone) 
                 VALUES (:tipo, :cpf, :nome, :email, :telefone)"
            );
            $stmt->execute([
                ':tipo' => $_POST['tipo_pessoa'],
                ':cpf' => $_POST['cpf_cnpj'],
                ':nome' => $_POST['nome_razao'],
                ':email' => $_POST['email'],
                ':telefone' => $_POST['telefone']
            ]);
            echo "Cliente cadastrado com sucesso!";
        }
    }
}